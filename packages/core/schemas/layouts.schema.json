{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heffrey78/gh-writer/schemas/v1/layouts.schema.json",
  "title": "diagrams/layouts.yaml",
  "type": "object",
  "properties": {
    "layouts": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_-]*$" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "object",
            "propertyNames": { "$ref": "common.schema.json#/$defs/id" },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
              },
              "required": ["x", "y"],
              "additionalProperties": false
            }
          }
        },
        "required": ["nodes"],
        "additionalProperties": false
      }
    }
  },
  "required": ["layouts"],
  "additionalProperties": false
}
