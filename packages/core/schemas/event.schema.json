{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heffrey78/gh-writer/schemas/v1/event.schema.json",
  "title": "Off-page event front matter (bible/events/<slug>.md)",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
    "when": { "$ref": "common.schema.json#/$defs/storyTime" },
    "duration": { "$ref": "common.schema.json#/$defs/duration" },
    "characters": { "$ref": "common.schema.json#/$defs/idList" },
    "locations": { "$ref": "common.schema.json#/$defs/idList" },
    "plotlines": { "$ref": "common.schema.json#/$defs/idList" },
    "scene": { "$ref": "common.schema.json#/$defs/id", "description": "The scene that dramatizes it." }
  },
  "required": ["id", "title"],
  "additionalProperties": false
}
