{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heffrey78/gh-writer/schemas/v1/chapter.schema.json",
  "title": "_chapter.yaml",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "$ref": "common.schema.json#/$defs/text" },
    "synopsis": { "$ref": "common.schema.json#/$defs/text" },
    "scenes": { "$ref": "common.schema.json#/$defs/idList" }
  },
  "required": ["id", "scenes"],
  "additionalProperties": false
}
